          "group": "1_workspace"
        },
        {
          "command": "governedWorkflow.editTicketContext",
          "when": "view == governedWorkflow.projects && viewItem == gwWorkspace",
          "group": "1_workspace"
        },
        {
          "command": "governedWorkflow.resumeClaude",
