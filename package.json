        },
        {
          "command": "governedWorkflow.killClaude",
          "when": "view == governedWorkflow.projects && viewItem == gwWorkspace",
          "group": "2_claude"
        },
        {
          "command": "governedWorkflow.archiveWorkspace",
          "when": "view == governedWorkflow.projects && viewItem == gwWorkspace",
          "group": "9_danger"
        },
        {
          "command": "governedWorkflow.runProjectSetup",
          "when": "view == governedWorkflow.projects && viewItem == gwProject",
          "group": "1_project"
        },
        {
          "command": "governedWorkflow.removeProject",
          "when": "view == governedWorkflow.projects && viewItem == gwProject",
          "group": "9_danger"
        },
        {
          "command": "governedWorkflow.approvePlan",
          "when": "view == governedWorkflow.state && viewItem == gwPlanPending",
          "group": "inline@1"
        },
        {
          "command": "governedWorkflow.rejectPlan",
          "when": "view == governedWorkflow.state && viewItem == gwPlanPending",
          "group": "inline@2"
        },
        {
          "command": "governedWorkflow.comments.reply",
          "when": "view == governedWorkflow.comments && viewItem =~ /gwComment/",
          "group": "inline@1"
        },
        {
          "command": "governedWorkflow.comments.resolve",
          "when": "view == governedWorkflow.comments && viewItem == gwCommentOpen",
          "group": "inline@2"
        },
        {
          "command": "governedWorkflow.comments.unresolve",
          "when": "view == governedWorkflow.comments && viewItem == gwCommentResolved",
          "group": "inline@2"
        },
        {
          "command": "governedWorkflow.comments.resolveFile",
          "when": "view == governedWorkflow.comments && viewItem == gwCommentFileOpen",
          "group": "inline@1"
        },
        {
          "command": "governedWorkflow.comments.resolveFile",
          "when": "view == governedWorkflow.comments && viewItem == gwCommentFileOpen",
          "group": "1_resolve@1"
        },
        {
          "command": "governedWorkflow.changes.openFile",
          "when": "view == governedWorkflow.changes && viewItem == gwChangeFile",
          "group": "inline@1"
        },
        {
          "command": "governedWorkflow.changes.openFile",
          "when": "view == governedWorkflow.changes && viewItem == gwChangeFile",
          "group": "1_open@1"
        },
        {
          "command": "governedWorkflow.changes.copyPath",
          "when": "view == governedWorkflow.changes && viewItem =~ /^gwChangeFile/",
          "group": "2_copy@1"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "governedWorkflow.comment.create",
          "group": "inline",
          "when": "commentController == governedWorkflow.review && commentThreadIsEmpty"
        },
        {
          "command": "governedWorkflow.comment.reply",
          "group": "inline",
          "when": "commentController == governedWorkflow.review && !commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "governedWorkflow.comment.resolve",
          "group": "inline",
          "when": "commentController == governedWorkflow.review && commentThread == open"
        },
        {
          "command": "governedWorkflow.comment.unresolve",
          "group": "inline",
          "when": "commentController == governedWorkflow.review && commentThread == resolved"
        },
        {
          "command": "governedWorkflow.comment.resolveFile",
          "group": "inline",
          "when": "commentController == governedWorkflow.review && !commentThreadIsEmpty"
        }
      ],
      "explorer/context": [
        {
          "command": "governedWorkflow.commentOnResource",
          "when": "governedWorkflow.hasWorkspace",
          "group": "7_governedWorkflow"
        }
      ],
      "editor/title/context": [
        {
          "command": "governedWorkflow.commentOnResource",
          "when": "governedWorkflow.hasWorkspace",
          "group": "7_governedWorkflow"
        }
      ],
      "editor/title": [
        {
          "command": "governedWorkflow.resolveFileComments",
          "when": "governedWorkflow.activeFileHasOpenComments",
          "group": "7_governedWorkflow"
        }
      ],
      "editor/context": [
        {
          "command": "governedWorkflow.resolveFileComments",
          "when": "governedWorkflow.activeFileHasOpenComments",
          "group": "7_governedWorkflow"
        }
      ]
    },
    "configurationDefaults": {
      "terminal.integrated.commandsToSkipShell": [
        "governedWorkflow.toggleTerminalFullScreen"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p webview-ui",
    "test": "vitest run",
    "harness": "node scripts/harness/server.mjs",
    "package": "vsce package",
    "vscode:prepublish": "node scripts/build.mjs --production"
  },
  "devDependencies": {
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.101.0",
    "@types/ws": "^8.18.2",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^12.0.2",
    "mermaid": "^11.17.2",
    "preact": "^10.29.8",
    "ws": "^8.22.2"
  }
