{
  "name": "governed-workflow-vscode",
  "displayName": "Governed Workflow",
  "description": "VS Code client for Governed Workflow: the Workspace Control panel with every web tab, comments in editors, diffs and panels, branch review, gate and plan approval, and the Claude session through the admin panel API.",
  "version": "0.2.18",
  "publisher": "ignatrozhko",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/IgnatRozhkoTR/governed-workflow-vscode"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:governedWorkflow.control"
  ],
  "contributes": {
    "configuration": {
      "title": "Governed Workflow",
      "properties": {
        "governedWorkflow.serverUrl": {
          "type": "string",
          "default": "http://localhost:5111",
          "description": "Base URL of the Governed Workflow admin panel."
        },
        "governedWorkflow.pollIntervalSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 3,
          "description": "How often the workspace state is polled while the VS Code window is focused and the Workspace Control panel is not visible (the panel polls every 3 seconds while visible)."
        },
        "governedWorkflow.terminal.maximize": {
          "type": "boolean",
          "default": true,
          "description": "Maximize the editor area when a Claude session terminal opens."
        },
        "governedWorkflow.onSelectWorkspace": {
          "type": "string",
          "enum": [
            "newWindow",
            "sameWindow",
            "addFolder",
            "off"
          ],
          "default": "newWindow",
          "enumDescriptions": [
            "Open the workspace worktree in a new window.",
            "Open the workspace worktree in this window (the window reloads).",
            "Add the workspace worktree to this window as another folder, without a reload.",
            "Only switch Workspace Control; open worktrees with the Open Worktree command."
          ],
          "description": "What happens when you pick a workspace (Projects view, Switch Workspace, Workspace Control) and this window is not already on its worktree. When the worktree is on the admin panel's machine instead of this one, it opens there over Remote - SSH (addFolder then opens a new window)."
        },
        "governedWorkflow.sshHost": {
          "type": "string",
          "default": "",
          "markdownDescription": "SSH target for opening worktrees that live on the admin panel's machine, for example `ig@mac` or a `~/.ssh/config` alias. Empty: the user reported by the admin panel at the host of `#governedWorkflow.serverUrl#`."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "governedWorkflow",
          "title": "Governed Workflow",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "governedWorkflow": [
        {
          "id": "governedWorkflow.projects",
          "name": "Projects"
        },
        {
          "id": "governedWorkflow.state",
          "name": "Workspace"
        },
        {
          "id": "governedWorkflow.changes",
          "name": "Changes"
        },
        {
          "id": "governedWorkflow.comments",
          "name": "Comments"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "governedWorkflow.projects",
        "contents": "Connect to the Governed Workflow admin panel.\n[Set Admin Token](command:governedWorkflow.setToken)\n[Configure Server URL](command:workbench.action.openSettings?%5B%22governedWorkflow.serverUrl%22%5D)"
      },
      {
        "view": "governedWorkflow.state",
        "contents": "Select a workspace in Projects to follow it here and open it in Workspace Control.\n[Switch Workspace](command:governedWorkflow.switchWorkspace)",
        "when": "!governedWorkflow.hasWorkspace"
      }
    ],
    "commands": [
      {
        "command": "governedWorkflow.selectWorkspace",
        "title": "Select Workspace",
        "category": "Governed Workflow"
      },
      {
        "command": "governedWorkflow.openWorktree",
        "title": "Open Worktree",
        "category": "Governed Workflow"
      },
      {
        "command": "governedWorkflow.createProject",
        "title": "Create Project",
        "category": "Governed Workflow",
        "icon": "$(new-folder)"
      },
      {
        "command": "governedWorkflow.createWorkspace",
        "title": "Create Workspace",
        "category": "Governed Workflow",
        "icon": "$(add)"
      },
      {
        "command": "governedWorkflow.editTicketContext",
        "title": "Edit Ticket Context",
        "category": "Governed Workflow"
      },
      {
        "command": "governedWorkflow.setToken",
        "title": "Set Admin Token",
        "category": "Governed Workflow"
      },
      {
        "command": "governedWorkflow.refresh",
        "title": "Refresh",
        "category": "Governed Workflow",
        "icon": "$(refresh)"
      },
      {
        "command": "governedWorkflow.openFileDiff",
        "title": "Open File Diff",
        "category": "Governed Workflow"
      },
      {
        "command": "governedWorkflow.openChanges",
        "title": "Open All Changes",
        "category": "Governed Workflow",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "governedWorkflow.changes.toggleMode",
        "title": "Toggle Changes Mode",
        "category": "Governed Workflow",
        "icon": "$(git-compare)"
      },
      {
        "command": "governedWorkflow.changes.refresh",
        "title": "Refresh Changes",
        "category": "Governed Workflow",
        "icon": "$(refresh)"
      },
      {
        "command": "governedWorkflow.comment.create",
        "title": "Add Review Comment",
        "category": "Governed Workflow"
      },
      {
        "command": "governedWorkflow.comment.reply",
        "title": "Reply",
        "category": "Governed Workflow"
      },
      {
        "command": "governedWorkflow.comment.resolve",
        "title": "Resolve Thread",
        "category": "Governed Workflow",
        "icon": "$(check)"
      },
      {
        "command": "governedWorkflow.comment.unresolve",
        "title": "Unresolve Thread",
        "category": "Governed Workflow",
        "icon": "$(discard)"
      },
      {
        "command": "governedWorkflow.resumeClaude",
        "title": "Resume Claude Session",
        "category": "Governed Workflow"
      },
      {
        "command": "governedWorkflow.startClaude",
        "title": "Start Fresh Claude Session",
        "category": "Governed Workflow"
      },
      {
        "command": "governedWorkflow.approveGate",
        "title": "Approve Gate",
        "category": "Governed Workflow",
        "icon": "$(check)"
      },
      {
        "command": "governedWorkflow.rejectGate",
        "title": "Reject Gate",
        "category": "Governed Workflow",
        "icon": "$(close)"
      },
      {
        "command": "governedWorkflow.gateActions",
        "title": "Gate Actions",
        "category": "Governed Workflow"
      },
      {
        "command": "governedWorkflow.openControlPanel",
        "title": "Open Workspace Control",
        "category": "Governed Workflow",
        "icon": "$(layout-panel)"
      },
      {
        "command": "governedWorkflow.openPlan",
        "title": "Open Plan",
        "category": "Governed Workflow",
        "icon": "$(checklist)"
      },
      {
        "command": "governedWorkflow.approvePlan",
        "title": "Approve Plan",
        "category": "Governed Workflow",
        "icon": "$(pass)"
      },
      {
        "command": "governedWorkflow.rejectPlan",
        "title": "Reject Plan",
        "category": "Governed Workflow",
        "icon": "$(error)"
      },
      {
        "command": "governedWorkflow.setPhase",
        "title": "Set Phase…",
        "category": "Governed Workflow",
        "icon": "$(milestone)"
      },
      {
        "command": "governedWorkflow.toggleYolo",
        "title": "Enable YOLO Mode",
        "category": "Governed Workflow",
        "icon": "$(rocket)"
      },
      {
        "command": "governedWorkflow.disableYolo",
        "title": "Disable YOLO Mode",
        "category": "Governed Workflow",
        "icon": "$(check)"
      },
      {
        "command": "governedWorkflow.notifyClaude",
        "title": "Notify Claude…",
        "category": "Governed Workflow",
        "icon": "$(bell)"
      },
      {
        "command": "governedWorkflow.switchWorkspace",
        "title": "Switch Workspace…",
        "category": "Governed Workflow",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "governedWorkflow.workWithAnotherMachine",
        "title": "Work with Another Machine",
        "category": "Governed Workflow"
      },
      {
        "command": "governedWorkflow.companions",
        "title": "Companions",
        "category": "Governed Workflow"
      },
      {
        "command": "governedWorkflow.killClaude",
        "title": "Kill Claude Session",
        "category": "Governed Workflow",
        "icon": "$(debug-stop)"
      },
      {
        "command": "governedWorkflow.terminalSessions",
        "title": "Terminal Sessions…",
        "category": "Governed Workflow",
        "icon": "$(terminal)"
      },
      {
        "command": "governedWorkflow.attachImage",
        "title": "Attach Image to Claude…",
        "category": "Governed Workflow",
        "icon": "$(file-media)"
      },
      {
        "command": "governedWorkflow.commentOnResource",
        "title": "Add Workflow Comment…",
        "category": "Governed Workflow",
        "icon": "$(comment)"
      },
      {
        "command": "governedWorkflow.removeProject",
        "title": "Remove Project",
        "category": "Governed Workflow",
        "icon": "$(trash)"
      },
      {
        "command": "governedWorkflow.archiveWorkspace",
        "title": "Archive Workspace",
        "category": "Governed Workflow",
        "icon": "$(archive)"
      },
      {
        "command": "governedWorkflow.toggleShowArchived",
        "title": "Show/Hide Archived Workspaces",
        "category": "Governed Workflow",
        "icon": "$(archive)"
      },
      {
        "command": "governedWorkflow.runProjectSetup",
        "title": "Run Project Setup…",
        "category": "Governed Workflow",
        "icon": "$(tools)"
      },
      {
        "command": "governedWorkflow.comments.filter",
        "title": "Filter Comments",
        "category": "Governed Workflow",
        "icon": "$(filter)"
      },
      {
        "command": "governedWorkflow.comments.open",
        "title": "Open Comment",
        "category": "Governed Workflow"
      },
      {
        "command": "governedWorkflow.comments.reply",
        "title": "Reply",
        "category": "Governed Workflow",
        "icon": "$(reply)"
      },
      {
        "command": "governedWorkflow.comments.resolve",
        "title": "Resolve Thread",
        "category": "Governed Workflow",
        "icon": "$(check)"
      },
      {
        "command": "governedWorkflow.comments.unresolve",
        "title": "Unresolve Thread",
        "category": "Governed Workflow",
        "icon": "$(discard)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "governedWorkflow.selectWorkspace",
          "when": "false"
        },
        {
          "command": "governedWorkflow.openWorktree",
          "when": "false"
        },
        {
          "command": "governedWorkflow.editTicketContext",
          "when": "false"
        },
        {
          "command": "governedWorkflow.openFileDiff",
          "when": "false"
        },
        {
          "command": "governedWorkflow.comment.create",
          "when": "false"
        },
        {
          "command": "governedWorkflow.comment.reply",
          "when": "false"
        },
        {
          "command": "governedWorkflow.comment.resolve",
          "when": "false"
        },
        {
          "command": "governedWorkflow.comment.unresolve",
          "when": "false"
        },
        {
          "command": "governedWorkflow.commentOnResource",
          "when": "false"
        },
        {
          "command": "governedWorkflow.removeProject",
          "when": "false"
        },
        {
          "command": "governedWorkflow.archiveWorkspace",
          "when": "false"
        },
        {
          "command": "governedWorkflow.comments.open",
          "when": "false"
        },
        {
          "command": "governedWorkflow.comments.reply",
          "when": "false"
        },
        {
          "command": "governedWorkflow.comments.resolve",
          "when": "false"
        },
        {
          "command": "governedWorkflow.comments.unresolve",
          "when": "false"
        },
        {
          "command": "governedWorkflow.approvePlan",
          "when": "governedWorkflow.planPending"
        },
        {
          "command": "governedWorkflow.rejectPlan",
          "when": "governedWorkflow.planPending"
        }
      ],
      "view/title": [
        {
          "command": "governedWorkflow.createProject",
          "when": "view == governedWorkflow.projects",
          "group": "navigation"
        },
        {
          "command": "governedWorkflow.createWorkspace",
          "when": "view == governedWorkflow.projects",
          "group": "navigation"
        },
        {
          "command": "governedWorkflow.refresh",
          "when": "view == governedWorkflow.projects",
          "group": "navigation"
        },
        {
          "command": "governedWorkflow.toggleShowArchived",
          "when": "view == governedWorkflow.projects",
          "group": "1_filter"
        },
        {
          "command": "governedWorkflow.openControlPanel",
          "when": "view == governedWorkflow.state",
          "group": "navigation@0"
        },
        {
          "command": "governedWorkflow.approvePlan",
          "when": "view == governedWorkflow.state && governedWorkflow.planPending",
          "group": "navigation@1"
        },
        {
          "command": "governedWorkflow.rejectPlan",
          "when": "view == governedWorkflow.state && governedWorkflow.planPending",
          "group": "navigation@2"
        },
        {
          "command": "governedWorkflow.switchWorkspace",
          "when": "view == governedWorkflow.state && governedWorkflow.hasWorkspace",
          "group": "1_workspace@1"
        },
        {
          "command": "governedWorkflow.setPhase",
          "when": "view == governedWorkflow.state && governedWorkflow.hasWorkspace",
          "group": "1_workspace@2"
        },
        {
          "command": "governedWorkflow.toggleYolo",
          "when": "view == governedWorkflow.state && governedWorkflow.hasWorkspace && !governedWorkflow.yolo",
          "group": "navigation@3"
        },
        {
          "command": "governedWorkflow.disableYolo",
          "when": "view == governedWorkflow.state && governedWorkflow.hasWorkspace && governedWorkflow.yolo",
          "group": "navigation@3"
        },
        {
          "command": "governedWorkflow.notifyClaude",
          "when": "view == governedWorkflow.state && governedWorkflow.hasWorkspace",
          "group": "2_claude@1"
        },
        {
          "command": "governedWorkflow.attachImage",
          "when": "view == governedWorkflow.state && governedWorkflow.hasWorkspace",
          "group": "2_claude@2"
        },
        {
          "command": "governedWorkflow.terminalSessions",
          "when": "view == governedWorkflow.state",
          "group": "2_claude@3"
        },
        {
          "command": "governedWorkflow.refresh",
          "when": "view == governedWorkflow.state",
          "group": "navigation"
        },
        {
          "command": "governedWorkflow.approveGate",
          "when": "view == governedWorkflow.state && governedWorkflow.gatePending",
          "group": "navigation"
        },
        {
          "command": "governedWorkflow.rejectGate",
          "when": "view == governedWorkflow.state && governedWorkflow.gatePending",
          "group": "navigation"
        },
        {
          "command": "governedWorkflow.changes.toggleMode",
          "when": "view == governedWorkflow.changes",
          "group": "navigation"
        },
        {
          "command": "governedWorkflow.changes.refresh",
          "when": "view == governedWorkflow.changes",
          "group": "navigation"
        },
        {
          "command": "governedWorkflow.openChanges",
          "when": "view == governedWorkflow.changes",
          "group": "navigation"
        },
        {
          "command": "governedWorkflow.comments.filter",
          "when": "view == governedWorkflow.comments",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "governedWorkflow.openWorktree",
          "when": "view == governedWorkflow.projects && viewItem == gwWorkspace",
          "group": "1_workspace"
        },
        {
          "command": "governedWorkflow.editTicketContext",
          "when": "view == governedWorkflow.projects && viewItem == gwWorkspace",
          "group": "1_workspace"
        },
        {
          "command": "governedWorkflow.resumeClaude",
          "when": "view == governedWorkflow.projects && viewItem == gwWorkspace",
          "group": "inline"
        },
        {
          "command": "governedWorkflow.startClaude",
          "when": "view == governedWorkflow.projects && viewItem == gwWorkspace",
          "group": "1_workspace"
        },
        {
          "command": "governedWorkflow.createWorkspace",
          "when": "view == governedWorkflow.projects && viewItem == gwProject",
          "group": "inline"
        },
        {
          "command": "governedWorkflow.killClaude",
          "when": "view == governedWorkflow.projects && viewItem == gwWorkspace",
          "group": "2_claude"
        },
        {
          "command": "governedWorkflow.archiveWorkspace",
          "when": "view == governedWorkflow.projects && viewItem == gwWorkspace",
          "group": "9_danger"
        },
        {
          "command": "governedWorkflow.runProjectSetup",
          "when": "view == governedWorkflow.projects && viewItem == gwProject",
          "group": "1_project"
        },
        {
          "command": "governedWorkflow.removeProject",
          "when": "view == governedWorkflow.projects && viewItem == gwProject",
          "group": "9_danger"
        },
        {
          "command": "governedWorkflow.approvePlan",
          "when": "view == governedWorkflow.state && viewItem == gwPlanPending",
          "group": "inline@1"
        },
        {
          "command": "governedWorkflow.rejectPlan",
          "when": "view == governedWorkflow.state && viewItem == gwPlanPending",
          "group": "inline@2"
        },
        {
          "command": "governedWorkflow.comments.reply",
          "when": "view == governedWorkflow.comments && viewItem =~ /gwComment/",
          "group": "inline@1"
        },
        {
          "command": "governedWorkflow.comments.resolve",
          "when": "view == governedWorkflow.comments && viewItem == gwCommentOpen",
          "group": "inline@2"
        },
        {
          "command": "governedWorkflow.comments.unresolve",
          "when": "view == governedWorkflow.comments && viewItem == gwCommentResolved",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "governedWorkflow.comment.create",
          "group": "inline",
          "when": "commentController == governedWorkflow.review && commentThreadIsEmpty"
        },
        {
          "command": "governedWorkflow.comment.reply",
          "group": "inline",
          "when": "commentController == governedWorkflow.review && !commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "governedWorkflow.comment.resolve",
          "group": "inline",
          "when": "commentController == governedWorkflow.review && commentThread == unresolved"
        },
        {
          "command": "governedWorkflow.comment.unresolve",
          "group": "inline",
          "when": "commentController == governedWorkflow.review && commentThread == resolved"
        }
      ],
      "explorer/context": [
        {
          "command": "governedWorkflow.commentOnResource",
          "when": "governedWorkflow.hasWorkspace",
          "group": "7_governedWorkflow"
        }
      ],
      "editor/title/context": [
        {
          "command": "governedWorkflow.commentOnResource",
          "when": "governedWorkflow.hasWorkspace",
          "group": "7_governedWorkflow"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p webview-ui",
    "test": "vitest run",
    "harness": "node scripts/harness/server.mjs",
    "package": "vsce package",
    "vscode:prepublish": "node scripts/build.mjs --production"
  },
  "devDependencies": {
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.101.0",
    "@types/ws": "^8.18.2",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^12.0.2",
    "mermaid": "^11.17.2",
    "preact": "^10.29.8",
    "ws": "^8.22.2"
  }
}
