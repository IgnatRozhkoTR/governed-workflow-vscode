    "keybindings": [
      {
        "command": "editor.action.submitComment",
        "key": "enter",
        "when": "commentEditorFocused && !suggestWidgetVisible && !inlineSuggestionVisible && !commentIsEmpty && commentController =~ /^governedWorkflow\\./"
      },
      {
        "command": "governedWorkflow.toggleTerminal",
        "key": "ctrl+alt+`",
        "mac": "ctrl+alt+`"
      },
      {
        "command": "governedWorkflow.toggleTerminal",
        "key": "ctrl+alt+`",
        "mac": "ctrl+alt+`",
        "when": "terminalFocus && governedWorkflow.claudeTerminalActive",
        "args": {
          "isFocused": true
        }
      },
      {
        "command": "governedWorkflow.showTerminal",
        "key": "ctrl+alt+t",
        "mac": "ctrl+alt+t"
      },
      {
        "command": "governedWorkflow.toggleTerminalFullScreen",
        "key": "ctrl+alt+shift+enter",
        "mac": "ctrl+alt+shift+enter"
      },
      {
        "command": "governedWorkflow.openChangesTab",
        "key": "ctrl+alt+shift+c",
        "mac": "ctrl+alt+shift+c"
      },
      {
        "command": "governedWorkflow.openScratchpads",
        "key": "ctrl+alt+shift+s",
        "mac": "ctrl+alt+shift+s"
      },
      {
        "command": "governedWorkflow.pasteImage",
        "key": "ctrl+v",
        "when": "isMac && terminalFocus && governedWorkflow.claudeTerminalActive",
        "args": {
          "fallbackInput": "\u0016"
        }
      },
      {
        "command": "governedWorkflow.pasteImage",
        "key": "alt+v",
        "when": "!isMac && terminalFocus && governedWorkflow.claudeTerminalActive",
        "args": {
          "fallbackInput": "\u001bv"
        }
      },
      {
        "command": "governedWorkflow.annotations.toggleExpanded",
        "key": "ctrl+alt+shift+a",
        "when": "editorTextFocus && governedWorkflow.annotationsEnabled"
      }
    ],
