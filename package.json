        },
        {
          "command": "governedWorkflow.changes.copyPath",
          "when": "false"
        },
        {
          "command": "governedWorkflow.annotations.add",
          "when": "editorIsOpen && governedWorkflow.hasWorkspace && governedWorkflow.annotationsEnabled"
        },
        {
          "command": "governedWorkflow.annotations.toggleExpanded",
          "when": "editorIsOpen && governedWorkflow.annotationsEnabled"
        },
        {
          "command": "governedWorkflow.annotations.edit",
          "when": "false"
        },
        {
          "command": "governedWorkflow.annotations.delete",
          "when": "false"
        },
        {
