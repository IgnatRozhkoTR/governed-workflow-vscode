{
  "name": "governed-workflow-vscode",
  "displayName": "Governed Workflow",
  "description": "VS Code client for Governed Workflow: the Workspace Control panel with every web tab, comments in editors, diffs and panels, branch review, gate and plan approval, and the Claude session through the admin panel API.",
  "version": "0.2.24",
  "publisher": "ignatrozhko",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/IgnatRozhkoTR/governed-workflow-vscode"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:governedWorkflow.control"
  ],
  "contributes": {
    "configuration": {
      "title": "Governed Workflow",
      "properties": {
        "governedWorkflow.serverUrl": {
          "type": "string",
          "default": "http://localhost:5111",
          "description": "Base URL of the Governed Workflow admin panel."
        },
        "governedWorkflow.pollIntervalSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 3,
          "description": "How often the workspace state is polled while the VS Code window is focused and the Workspace Control panel is not visible (the panel polls every 3 seconds while visible)."
        },
        "governedWorkflow.terminal.layout": {
          "type": "string",
          "enum": [
            "panel",
            "editor",
            "fullscreen"
          ],
          "default": "editor",
          "enumDescriptions": [
            "The terminal panel. Drag the Terminal view to the bottom panel or the secondary side bar to choose where it docks.",
            "A tab in the active editor group.",
            "A tab in the active editor group, with that group maximised so the other groups are hidden."
          ],
          "markdownDescription": "Where the workspace's Claude terminal opens. Switch with the status bar item, **Claude Terminal Layout…** or **Toggle Claude Terminal Full Screen**; an open terminal is moved without reconnecting. When unset, `#governedWorkflow.terminal.maximize#` set to `true` means `fullscreen`."
        },
        "governedWorkflow.terminal.maximize": {
          "type": "boolean",
          "default": true,
          "description": "Maximize the editor area when a Claude session terminal opens.",
          "markdownDeprecationMessage": "Use `#governedWorkflow.terminal.layout#` instead. While the layout is unset, `true` here selects `fullscreen`."
        },
        "governedWorkflow.onSelectWorkspace": {
          "type": "string",
          "enum": [
            "newWindow",
            "sameWindow",
            "addFolder",
            "off"
          ],
          "default": "newWindow",
          "enumDescriptions": [
            "Open the workspace worktree in a new window.",
            "Open the workspace worktree in this window (the window reloads).",
            "Add the workspace worktree to this window as another folder, without a reload.",
            "Only switch Workspace Control; open worktrees with the Open Worktree command."
          ],
          "description": "What happens when you pick a workspace (Projects view, Switch Workspace, Workspace Control) and this window is not already on its worktree. When the worktree is on the admin panel's machine instead of this one, it opens there over Remote - SSH (addFolder then opens a new window)."
        },
        "governedWorkflow.sshHost": {
          "type": "string",
          "default": "",
          "markdownDescription": "SSH target for opening worktrees that live on the admin panel's machine, for example `ig@mac` or a `~/.ssh/config` alias. Empty: the user reported by the admin panel at the host of `#governedWorkflow.serverUrl#`."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "governedWorkflow",
          "title": "Governed Workflow",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "governedWorkflow": [
        {
          "id": "governedWorkflow.projects",
          "name": "Projects"
        },
        {
          "id": "governedWorkflow.state",
          "name": "Workspace"
        },
        {
          "id": "governedWorkflow.changes",
          "name": "Changes"
        },
        {
          "id": "governedWorkflow.comments",
          "name": "Comments"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "governedWorkflow.projects",
        "contents": "Connect to the Governed Workflow admin panel.\n[Set Admin Token](command:governedWorkflow.setToken)\n[Configure Server URL](command:workbench.action.openSettings?%5B%22governedWorkflow.serverUrl%22%5D)"
      },
      {
        "view": "governedWorkflow.state",
        "contents": "Select a workspace in Projects to follow it here and open it in Workspace Control.\n[Switch Workspace](command:governedWorkflow.switchWorkspace)",
        "when": "!governedWorkflow.hasWorkspace"
      },
      {
        "view": "governedWorkflow.changes",
        "contents": "Select a workspace to see the files it changed.\n[Switch Workspace](command:governedWorkflow.switchWorkspace)",
        "when": "!governedWorkflow.hasWorkspace"
      },
      {
        "view": "governedWorkflow.changes",
        "contents": "No changes on this branch against its source branch.\n[Show Uncommitted Changes](command:governedWorkflow.changes.showUncommitted)",
        "when": "governedWorkflow.hasWorkspace && governedWorkflow.changes.loaded && governedWorkflow.changes.mode != uncommitted"
      },
      {
        "view": "governedWorkflow.changes",
        "contents": "No uncommitted changes.\n[Show Branch Changes](command:governedWorkflow.changes.showBranch)",
        "when": "governedWorkflow.hasWorkspace && governedWorkflow.changes.loaded && governedWorkflow.changes.mode == uncommitted"
      }
    ],
    "commands": [
      {
        "command": "governedWorkflow.selectWorkspace",
        "title": "Select Workspace",
        "category": "Governed Workflow"
      },
      {
