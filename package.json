          "group": "navigation@8"
        },
        {
          "command": "governedWorkflow.changes.showUncommitted",
          "when": "view == governedWorkflow.changes && governedWorkflow.changes.mode != uncommitted",
          "group": "navigation@1"
        },
        {
          "command": "governedWorkflow.changes.showBranch",
          "when": "view == governedWorkflow.changes && governedWorkflow.changes.mode == uncommitted",
          "group": "navigation@1"
        },
        {
          "command": "governedWorkflow.openChanges",
          "when": "view == governedWorkflow.changes",
          "group": "navigation@2"
        },
        {
          "command": "governedWorkflow.changes.refresh",
          "when": "view == governedWorkflow.changes",
          "group": "navigation@3"
        },
        {
          "command": "governedWorkflow.changes.viewAsList",
