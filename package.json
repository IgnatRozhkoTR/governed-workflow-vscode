      "view/title": [
        {
          "command": "governedWorkflow.createProject",
          "when": "view == governedWorkflow.projects",
          "group": "navigation"
        },
        {
          "command": "governedWorkflow.createWorkspace",
          "when": "view == governedWorkflow.projects",
          "group": "navigation"
